# Local .env example for development
# Copy to .env and replace secrets before running in any shared environment

# PostgreSQL connection (local docker-compose service uses these defaults)
DATABASE_URL=postgres://iitd_drop:local-only-change-me@localhost:5432/iitd_drop
DATABASE_SSL=false
DB_POOL_SIZE=10

# Required application secrets
SESSION_SECRET=change-me
OTP_SECRET=change-me

# Admin user (generate ADMIN_PASSWORD_HASH using scripts/hash-password.mjs)
ADMIN_EMAIL=admin@iitdmerch.local
ADMIN_PASSWORD_HASH=replace-with-argon2-hash

# Optional runtime flags
RAZORPAY_MODE=demo
SMS_PROVIDER=demo
# Demo-only fixed OTP; do not enable this outside a demonstration environment
DEMO_OTP=202626
# Browser-safe key for Places autocomplete; in production use the App Service Key Vault reference
GOOGLE_MAPS_BROWSER_KEY=

# For production consider using Azure Key Vault or App Service managed settings rather than a file
